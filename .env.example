# Local Postgres from `docker compose up -d db`. Change this when you use another database.
DATABASE_URL=postgres://scoutroles:scoutroles@localhost:5432/scoutroles

# Included letters for free accounts. Paste a key from https://aistudio.google.com/apikey
# Copy this file to .env.local and restart the dev server.
GEMINI_API_KEY=

# Sign-in. Callback for every provider: http://localhost:3000/api/pass/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
